{
  "name": "@question-os/core",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "Portable, game-independent LadybugDB knowledge graph and query SDK.",
  "scripts": {
    "test": "node --test",
    "test:new": "node tools/knowledge-verify.js",
    "test:full": "npm run validate && npm test",
    "validate": "node tools/validate-all.js",
    "knowledge:inspect": "node tools/knowledge-author.js inspect",
    "knowledge:names": "node tools/knowledge-find-names.js",
    "knowledge:check": "node tools/knowledge-author.js check",
    "knowledge:apply": "node tools/knowledge-author.js apply",
    "knowledge:ladybug:export": "node tools/ladybug-export.js",
    "knowledge:ladybug:import": "node tools/ladybug-import.js",
    "check": "npm run test:full"
  },
  "exports": "./src/index.js",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ladybugdb/core": "^0.21.2"
  }
}
