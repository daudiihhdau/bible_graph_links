{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://question-os.dev/schemas/7.0/package.schema.json",
  "title": "Question OS package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "packageVersion",
    "title"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "7.0",
      "description": "Version der verbindlichen Datenstruktur."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+/[a-z0-9-]+(?:/[a-z0-9-]+)+$",
      "description": "Stabile, weltweit eindeutige ID dieses Pakets."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Lesbarer Titel dieses Pakets."
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "packageVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
      "description": "Version dieses Wissenspakets, unabhängig von schemaVersion."
    },
    "requiredPackageIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9.-]+/[a-z0-9-]+(?:/[a-z0-9-]+)+$"
      },
      "uniqueItems": true,
      "description": "IDs anderer Pakete, deren Entitäten dieses Paket verwendet."
    }
  }
}
